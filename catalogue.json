{
  "catalogue_version": 1,
  "type": "sloppy.plugin-catalogue",
  "name": "Sloppy Plugin Catalogue",
  "description": "Public plugins for Sloppy.",
  "plugins": [
    {
      "id": "codex",
      "name": "OpenAI Codex",
      "description": "Mirrors native Codex approvals, questions, and MCP elicitation without replacing its terminal UI.",
      "repository": "https://github.com/sloppy-plugins/codex.git",
      "versions": [
        {
          "version": "0.1.4",
          "package_directory": "package",
          "manifest": {
            "manifest_version": 1,
            "protocol_version": 1,
            "plugin": {
              "id": "codex",
              "name": "OpenAI Codex",
              "version": "0.1.4",
              "description": "Mirrors native Codex approvals, questions, and MCP elicitation without replacing its terminal UI.",
              "layouts": {
                "approval": {
                  "template": "command",
                  "accent": "brown",
                  "width": 460,
                  "show_details": true,
                  "input_placeholder": "Write your reply..."
                },
                "question": {
                  "template": "card",
                  "accent": "purple",
                  "width": 460,
                  "show_details": true,
                  "input_placeholder": "Reply here or in your terminal..."
                }
              },
              "icon": "data:image/png;base64,"
            },
            "runtime": {
              "kind": "process",
              "interpreter": "node",
              "executables": {
                "macos-aarch64": "dist/launch.mjs",
                "macos-x86_64": "dist/launch.mjs",
                "linux-aarch64": "dist/launch.mjs",
                "linux-x86_64": "dist/launch.mjs",
                "windows-x86_64": "dist/launch.mjs",
                "windows-aarch64": "dist/launch.mjs"
              }
            },
            "dependencies": [
              {
                "runtime": "node",
                "minimum_version": "22.23.4"
              }
            ],
            "initialization": [
              {
                "kind": "npm_install",
                "directory": "."
              },
              {
                "kind": "command",
                "program": "npm",
                "arguments": [
                  "run",
                  "build"
                ],
                "directory": ".",
                "if_missing": "dist/launch.mjs"
              }
            ]
          },
          "source": {
            "kind": "npm",
            "package": "@sloppy-plugins/codex",
            "url": "https://registry.npmjs.org/@sloppy-plugins/codex/-/codex-0.1.4.tgz",
            "sha256": "4ce83b6c599b34aa58a53eff1fca6e801d4db74bf56cd630baaa50af8d23f527",
            "format": "tar.gz"
          }
        }
      ]
    },
    {
